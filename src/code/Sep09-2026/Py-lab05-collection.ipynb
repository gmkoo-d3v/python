   "source": [
    "# scores 가 주어집니다. 직접 시험해보려면 아래 줄의 # 을 지우세요.\n",
    "scores = {\"민수\": 88, \"영희\": 72}\n",
    "\n",
    "# 1. 영희를 95점으로 고치세요\n",
    "scores[\"영희\"] = 95\n",
    "\n",
    "# 2. 철수를 78점으로 넣으세요\n",
    "scores['철수'] = 78\n",
    "\n",
    "# 3. 점수만 모아 높은 순으로 정렬하세요\n",
    "ranking = sorted(scores.values(), reverse=True)\n",
    "\n",
    "print(ranking)\n"
   ]
  }
