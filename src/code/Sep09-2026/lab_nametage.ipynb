   "source": [
    "# full_name 이 주어집니다. 직접 시험해보려면 아래 줄의 # 을 지우세요.\n",
    "full_name = \"김민수\"\n",
    "\n",
    "family = full_name[:1]          # 성 한 글자\n",
    "given = full_name[1:]           # 나머지 이름\n",
    "label = f'\"{full_name} 님 (성: {family}, 이름: {given})\"'           # 예: \"김민수 님 (성: 김, 이름: 민수)\"\n",
    "print(label)"
   ]
  }
